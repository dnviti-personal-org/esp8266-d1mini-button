layer.current {"name": "notes"}
text {"at": [35.0, 60.0], "text": "Perfboard 70 × 50 mm — SOLDER SIDE — mirrored view, rev C", "height": 2.5, "justify": "MC"}
text {"at": [35.0, 56.5], "text": "Seen from below: column X on the LEFT, A on the RIGHT, row 1 = USB edge. Part outlines dashed (they are on the other side).", "height": 1.5, "justify": "MC"}
text {"at": [35.0, -6.0], "text": "USB edge (y = 0)", "height": 1.5, "justify": "MC"}
text {"at": [0, -9.5], "text": "Thick short lines = bare tinned wire links; blob between A10/A11 = JP1", "height": 1.25, "justify": "ML"}
text {"at": [0, -11.7], "text": "solder bridge (closed = battery mode). Coloured lines = insulated 26 AWG", "height": 1.25, "justify": "ML"}
text {"at": [0, -13.9], "text": "wires on this side; number in the circle = row of the legend; dots = wire", "height": 1.25, "justify": "ML"}
text {"at": [0, -16.1], "text": "ends in the holes. Max two wire ends per hole. M1 pads are on the component", "height": 1.25, "justify": "ML"}
text {"at": [0, -18.3], "text": "side (module glued): its five wires are soldered to the pads above and", "height": 1.25, "justify": "ML"}
text {"at": [0, -20.5], "text": "come down past the module edge. Source: layout/layout.json rev C (wires[]),", "height": 1.25, "justify": "ML"}
text {"at": [0, -22.7], "text": "same numbering as BUILD.md.", "height": 1.25, "justify": "ML"}
