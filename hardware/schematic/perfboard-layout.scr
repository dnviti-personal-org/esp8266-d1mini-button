text {"at": [-10.5, 11.5], "text": "lever through the x = 0 wall", "height": 1.2, "justify": "MR"}
text {"at": [0, -19.5], "text": "WIRING: see the solder side sheet (perfboard-solder-side) — no wires on this sheet.", "height": 1.6, "justify": "ML"}
text {"at": [0, -22.5], "text": "Filled dots = leads soldered in grid holes; M1 is glued (foam tape) and wired from its 5 pads; JP1 = solder bridge A10–A11 (closed = battery mode).", "height": 1.3, "justify": "ML"}
text {"at": [0, -25.0], "text": "BT1 LiPo lies on the enclosure floor under the board; M2 INMP441 sits under the lid, 6-wire lead to J2. Source: layout/layout.json rev C.", "height": 1.3, "justify": "ML"}
