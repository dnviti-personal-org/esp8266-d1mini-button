text {"at": [35.0, 56.5], "text": "2.54 mm grid 24 × 18 holes Ø1.0 (A1 at 5.79, 3.41); 5 × 5 mm corner notches; mounting holes L1, L18, C17, X11 drilled Ø2.2 (Ø5 standoff dashed)", "height": 1.5, "justify": "MC"}
text {"at": [17.22, -5.4], "text": "micro-USB edge (y = 0)", "height": 1.5, "justify": "MC"}
